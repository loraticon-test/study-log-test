<!DOCTYPE html>
<html lang="ko" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FDFBF7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="단어 복습 테스트">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="application-name" content="단어 복습 테스트">
  <link rel="manifest" id="app-manifest">
  <script>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const hasInstallConfig = Boolean(
        (params.get('proxy') || params.get('proxyUrl')) &&
        (params.get('key') || params.get('apiKey')) &&
        (params.get('test') || params.get('testDbId'))
      );
      const manifest = {
        id: new URL('./test.html', window.location.href).href,
        name: '단어 복습 테스트',
        short_name: '단어 테스트',
        description: '단어 입력과 단어 뜻 복습을 한 곳에서 실행하는 테스트입니다.',
        scope: new URL('./', window.location.href).href,
        display: 'standalone',
        orientation: 'portrait',
        background_color: '#FDFBF7',
        theme_color: '#A67B5B',
        icons: [
          { src: new URL('../../assets/images/icons/test/icon-192.png', window.location.href).href, sizes: '192x192', type: 'image/png', purpose: 'any maskable' },
          { src: new URL('../../assets/images/icons/test/icon-512.png', window.location.href).href, sizes: '512x512', type: 'image/png', purpose: 'any maskable' }
        ]
      };
      const manifestUrl = `data:application/manifest+json;charset=utf-8,${encodeURIComponent(JSON.stringify(manifest))}`;
      document.getElementById('app-manifest')?.setAttribute('href', manifestUrl);
    })();
  </script>
  <script src="../../assets/js/install-config.js?v=20260724-0002" data-app="test"></script>
  <link rel="icon" type="image/svg+xml" href="../../assets/images/icons/test/icon.svg">
  <link rel="icon" type="image/png" sizes="192x192" href="../../assets/images/icons/test/icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="../../assets/images/icons/test/icon-512.png">
  <link rel="apple-touch-icon" sizes="180x180" href="../../assets/images/icons/test/apple-touch-icon.png">
  <title>🧠 단어 복습 테스트</title>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css">
  <script>
    (() => {
      const mode = new URLSearchParams(window.location.search).get('mode');
      if (mode === 'input' || mode === 'meaning') {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = mode === 'meaning' ? '../../assets/css/word-meaning.css' : '../../assets/css/test.css';
        document.head.appendChild(css);
      }
    })();
  </script>
  <style>
    :root { color-scheme: light dark; font-family: Pretendard Variable, Pretendard, -apple-system, BlinkMacSystemFont, system-ui, sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 320px; min-height: 100vh; background: #fdfbf7; color: #292524; }
    .mode-page { min-height: 100vh; display: grid; place-items: center; padding: 28px 20px; }
    .mode-card { width: min(100%, 480px); padding: 32px 24px 24px; border: 1px solid #e7ded3; border-radius: 28px; background: rgba(255,255,255,.92); box-shadow: 0 18px 55px rgba(91,66,45,.12); }
    .mode-eyebrow { margin: 0 0 8px; color: #a67b5b; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-align: center; }
    .mode-title { margin: 0; font-size: clamp(27px, 7vw, 36px); line-height: 1.2; text-align: center; }
    .mode-copy { margin: 12px auto 26px; color: #78716c; font-size: 15px; line-height: 1.6; text-align: center; }
    .mode-options { display: grid; gap: 12px; }
    .mode-button { width: 100%; display: grid; grid-template-columns: 48px 1fr 24px; align-items: center; gap: 14px; padding: 17px 16px; border: 1px solid #e7ded3; border-radius: 18px; background: #fff; color: inherit; text-align: left; cursor: pointer; transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease; }
    .mode-button:hover { transform: translateY(-2px); border-color: #c9ad96; box-shadow: 0 10px 24px rgba(91,66,45,.10); }
    .mode-button:focus-visible { outline: 3px solid rgba(166,123,91,.3); outline-offset: 2px; }
    .mode-icon { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 15px; background: #f5ece4; font-size: 24px; }
    .mode-name { display: block; margin-bottom: 4px; font-size: 17px; font-weight: 800; }
    .mode-desc { display: block; color: #78716c; font-size: 13px; line-height: 1.45; }
    .mode-arrow { color: #a67b5b; font-size: 22px; }
    .mode-note { margin: 18px 4px 0; color: #8b8179; font-size: 12px; line-height: 1.5; text-align: center; }
    .test-mode-back { position: fixed; top: calc(1.25rem + 16px); left: calc(1.25rem + 16px); z-index: 9999; width: 38px; height: 38px; display: grid; place-items: center; padding: 0; border: 1px solid rgba(166,123,91,.28); border-radius: 12px; background: rgba(255,255,255,.82); color: #795f4a; box-shadow: 0 4px 14px rgba(91,66,45,.10); font: 700 23px/1 Pretendard Variable, Pretendard, sans-serif; cursor: pointer; backdrop-filter: blur(10px); transition: transform .16s ease, background-color .16s ease; }
    .test-mode-back:hover { transform: translateX(-2px); background: #fff; }
    .test-mode-back:focus-visible { outline: 3px solid rgba(166,123,91,.3); outline-offset: 2px; }
    @media (prefers-color-scheme: dark) {
      body { background: #191919; color: #f5f5f4; }
      .mode-card { border-color: #3f3a36; background: rgba(42,42,42,.96); box-shadow: 0 18px 55px rgba(0,0,0,.3); }
      .mode-copy, .mode-desc, .mode-note { color: #b8b0aa; }
      .mode-button { border-color: #4a433e; background: #33302e; }
      .mode-button:hover { border-color: #a67b5b; }
      .mode-icon { background: #493c33; }
      .test-mode-back { border-color: rgba(201,173,150,.35); background: rgba(42,42,42,.9); color: #d9b99f; box-shadow: 0 6px 18px rgba(0,0,0,.28); }
      .test-mode-back:hover { background: #33302e; }
    }
  </style>
</head>
<body>
  <div id="root" class="w-full h-full flex justify-center items-center"></div>
  <script>
    Promise.resolve(window.STUDY_INSTALL_READY).finally(() => {
    (() => {
      const params = new URLSearchParams(window.location.search);
      const mode = params.get('mode');
      const root = document.getElementById('root');

      const chooseMode = (nextMode) => {
        const next = new URL(window.location.href);
        next.searchParams.set('mode', nextMode);
        window.location.assign(next.href);
      };

      if (mode !== 'input' && mode !== 'meaning') {
        root.className = '';
        root.innerHTML = `
          <main class="mode-page">
            <section class="mode-card" aria-labelledby="mode-title">
              <p class="mode-eyebrow">REVIEW MODE</p>
              <h1 class="mode-title" id="mode-title">어떤 테스트를 할까요?</h1>
              <p class="mode-copy">오늘 연습할 방식을 선택하세요.<br>두 모드의 결과는 같은 복습주기에 함께 반영됩니다.</p>
              <div class="mode-options">
                <button class="mode-button" type="button" data-mode="input">
                  <span class="mode-icon" aria-hidden="true">⌨️</span>
                  <span><span class="mode-name">단어 입력 테스트</span><span class="mode-desc">뜻을 보고 알맞은 단어를 직접 입력해요.</span></span>
                  <span class="mode-arrow" aria-hidden="true">›</span>
                </button>
                <button class="mode-button" type="button" data-mode="meaning">
                  <span class="mode-icon" aria-hidden="true">💡</span>
                  <span><span class="mode-name">단어 뜻 테스트</span><span class="mode-desc">단어를 보고 뜻을 떠올린 뒤 확인해요.</span></span>
                  <span class="mode-arrow" aria-hidden="true">›</span>
                </button>
              </div>
              <p class="mode-note">기존 누적 통과·오답·다음 복습일 기록은 그대로 유지됩니다.</p>
            </section>
          </main>`;
        root.querySelectorAll('[data-mode]').forEach((button) => {
          button.addEventListener('click', () => chooseMode(button.dataset.mode));
        });
        return;
      }

      const ensureBackButton = () => {
        if (document.querySelector('.test-mode-back')) return;
        const backButton = document.createElement('button');
        backButton.type = 'button';
        backButton.className = 'test-mode-back';
        backButton.setAttribute('aria-label', '테스트 유형 선택으로 돌아가기');
        backButton.title = '테스트 유형 선택';
        backButton.innerHTML = '<span aria-hidden="true">‹</span>';
        backButton.addEventListener('click', () => {
          const next = new URL(window.location.href);
          next.searchParams.delete('mode');
          window.location.assign(next.href);
        });
        document.body.appendChild(backButton);
      };
      ensureBackButton();
      const backButtonObserver = new MutationObserver(ensureBackButton);
      backButtonObserver.observe(document.body, { childList: true });

      const appScript = document.createElement('script');
      appScript.src = mode === 'meaning'
        ? '../../assets/js/word-meaning-app.js?v=20260723-0002'
        : '../../assets/js/test-app.js?v=20260723-0002';
      document.body.appendChild(appScript);
    })();
      });
  </script>
  <script>
    if ('serviceWorker' in navigator && ['https:', 'http:'].includes(window.location.protocol)) {
      window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(() => {}));
    }
  </script>
</body>
</html>
