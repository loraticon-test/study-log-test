        .mode-tab { transition: color 0.2s; }
        .mode-slider { transition: transform 0.25s cubic-bezier(.4,0,.2,1); }
        .mini-cat-stage { position: relative; width: 122px; height: 138px; margin: 0 auto; }
        .mini-cat-stage img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; user-select: none; }
        .mini-cat-bg { border-radius: 1.35rem; border: 1px solid var(--theme-border); padding: .5rem .5rem .2rem; transition: background .25s, border-color .25s; }
        
        /* 다크모드 대응 드롭다운 */
        .subject-dropdown {
            position: absolute; top: calc(100% + 6px); left: 0; right: 0;
            background: var(--theme-surface); border: 1px solid var(--theme-border); border-radius: 1rem;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08); z-index: 50; overflow: hidden;
        }
        .dark .subject-dropdown {
            background: #191919; border-color: #2F2F2F;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }
        .subject-option { padding: 10px 16px; cursor: pointer; font-size: 0.875rem; transition: background 0.15s; }
        .subject-option.has-parent { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .subject-parent-badge { padding: 4px 8px; border-radius: 999px; font-size: 0.6875rem; font-weight: 700; line-height: 1; color: #FFFFFF; background: #1A1A1A; white-space: nowrap; }
        .dark .subject-parent-badge { background: #F3F4F6; color: #1A1A1A; }
        .subject-option:hover { background: var(--theme-soft); }
        .dark .subject-option:hover { background: #252525; }
        .theme-hover:hover { color: var(--theme-color); }

        /* 다크모드 대응 커피잔 */
        .cup-body { fill: #FFFFFF; transition: fill 0.3s; }
        .cup-handle { stroke: #FFFFFF; transition: stroke 0.3s; }
        .cup-inner { fill: var(--theme-soft); transition: fill 0.3s; }
        .cup-text { fill: var(--theme-muted); transition: fill 0.3s; }
        .cup-shadow-line { stroke: rgba(0,0,0,0.06); transition: stroke 0.3s; }

        .dark .cup-body { fill: #2C2C2C; }
        .dark .cup-handle { stroke: #2C2C2C; }
        .dark .cup-inner { fill: #1E1E1E; }
        .dark .cup-text { fill: #666666; }
        .dark .cup-shadow-line { stroke: rgba(255,255,255,0.04); }

        @keyframes slideUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .toast { animation: slideUp 0.3s ease; }
        @keyframes fadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
        .record-item { animation: fadeIn 0.25s ease; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .spin { animation: spin 0.8s linear infinite; }
        .screen-wrap { display: flex; transition: transform 0.35s cubic-bezier(.4,0,.2,1); width: 200%; }
        .screen { width: 50%; flex-shrink: 0; }

/* Timer clock CoffeeCat sizing controls */
.timer-clock-visual {
    --timer-clock-visual-height: 18.75rem;
    --timer-clock-cat-box: 18rem;
    --timer-clock-stage-width: 248px;
    --timer-clock-stage-height: 281px;
    --timer-clock-shift-x: 0.7rem;
    --timer-clock-time-offset: -2.15rem;
    width: 100%;
    height: var(--timer-clock-visual-height);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: .35rem 0 .15rem;
}
.timer-clock-cat {
    width: var(--timer-clock-cat-box);
    height: var(--timer-clock-cat-box);
    transform: translateX(var(--timer-clock-shift-x));
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent !important;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
}
.timer-clock-cat .mini-cat-stage {
    width: var(--timer-clock-stage-width);
    height: var(--timer-clock-stage-height);
}
@keyframes timerClockCatFloat {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -3px, 0); }
}
.timer-clock-cat .timer-clock-float-layer {
    animation: timerClockCatFloat 4s ease-in-out infinite;
    will-change: transform;
}
@media (prefers-reduced-motion: reduce) {
    .timer-clock-cat .timer-clock-float-layer {
        animation: none;
        will-change: auto;
    }
}
.timer-clock-time {
    margin-top: var(--timer-clock-time-offset);
    transform: translateX(5px);
}
.timer-clock-time::after {
    content: attr(data-current-date);
    display: block;
    min-height: 1.1rem;
    margin-top: .55rem;
    color: #9A8B7F;
    font-family: "Pretendard Variable", Pretendard, sans-serif;
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .04em;
    line-height: 1.4;
    text-align: center;
    transform: translateX(-0.50rem);
}
.timer-time-widget {
    font-family: 'Fredoka', Pretendard, ui-sans-serif, system-ui, sans-serif;
    font-size: 2.7rem;
    font-weight: 500;
    letter-spacing: .08em;
    color: #5C3A21;
    font-variant-numeric: tabular-nums;
    line-height: 1;
}
.dark .timer-time-widget { color: #F3E6D6; }
.dark .timer-clock-time::after { color: #A8A29E; }
/* end timer custom css */
